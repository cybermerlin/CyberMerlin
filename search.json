---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title": "{{ post.title | escape }}",
      "url": "{{ post.url | prepend: site.baseurl }}",
      "date": "{{ post.date | date: "%B %e, %Y" }}",
      "tags": "{{ post.tags | join: ', ' }}"
    }
    {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
